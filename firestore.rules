rules_version = '2';

// Правила Firestore проекта metronom-a2035. Действуют те, что опубликованы в
// консоли Firebase (Firestore → Rules) — этот файл их копия для истории и
// ревью: правите здесь — вставьте и опубликуйте в консоли (или
// `firebase deploy --only firestore:rules`).
//
// Всё приложение живёт под users/{uid} (src/data/userLibrary.ts): документ
// пользователя, плейлисты, песни плейлистов, биты. Доступ — только самому
// вошедшему пользователю к своему поддереву. Других коллекций нет — всё
// остальное закрыто по умолчанию (в том числе ранние коллекции «по коду
// плейлиста», если они ещё лежат в базе).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
